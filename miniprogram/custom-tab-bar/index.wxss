/* custom-tab-bar/index.wxss */
/* 玉露丹青 - 毛玻璃悬浮导航栏 */

/* 使用全局主题色变量 */
:host {
  --tab-primary: var(--color-primary, #38A385);
  --tab-text-sub: var(--color-text-muted, #8B959E);
}

/* 底栏容器 */
.tab-bar-container {
  position: fixed;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  z-index: 1000;
  transform: translateY(10px);
}

/* 底栏主体 - 毛玻璃效果 */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(122rpx + 10px);
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 999rpx;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
}

/* Tab 项 */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  position: relative;
  transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Tab 项选中态 - 无上移效果 */
.tab-item.active {
  transform: translateY(0);
}

/* 图标容器 */
.tab-icon-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
}

/* 图标 */
.tab-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 300ms ease;
  position: relative;
  z-index: 2;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  transition: all 300ms ease;
}

/* 光晕效果 */
.tab-glow {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(56, 163, 133, 0.2) 0%, transparent 70%);
  z-index: 1;
}

/* 标签文字 - 未选中态显示浅灰色 */
.tab-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tab-text-sub);
  opacity: 0.6;
  transform: translateY(0);
  transition: all 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-top: 4rpx;
}

/* 选中态文字 - 变为主题绿色 */
.tab-label.active {
  color: var(--tab-primary) !important;
  opacity: 1 !important;
}

/* 安全区占位 */
.safe-area-placeholder {
  width: 100%;
  background: transparent;
}
