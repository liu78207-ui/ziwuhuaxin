/* pages/habits/habits.wxss */
/* 修习页面 - 玉露丹青极致清透版 */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg-primary);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ============================================
   固定头部区域
   ============================================ */
.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-primary);
  z-index: 100;
  padding: 0 48rpx;
  min-height: var(--nav-mask-height);
}

/* ============================================
   导航栏标题
   ============================================ */
.nav-header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.1em;
}

.env-badge {
  position: absolute;
  right: 48rpx;
  top: calc(var(--nav-mask-height) - 58rpx);
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(196, 120, 106, 0.14);
  border: 1rpx solid rgba(196, 120, 106, 0.34);
  color: #9A5E54;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 40rpx;
  box-sizing: border-box;
  pointer-events: none;
  white-space: nowrap;
}

/* ============================================
   顶部 Tab 切换器
   ============================================ */
.tabs-top {
  display: flex;
  gap: 48rpx;
  margin-bottom: 0;
  padding-bottom: 12rpx;
}

.tab-l-item {
  font-size: 30rpx;
  color: var(--text-tertiary);
  padding: 12rpx 0;
  position: relative;
  transition: color 300ms ease;
  font-weight: 500;
}

.tab-l-item.active {
  color: var(--text-primary);
  font-weight: 600;
}

/* Active 状态下方的短划线 - 绿色胶囊形 */
.tab-l-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background-color: var(--c-primary);
  border-radius: 999rpx;
}

/* ============================================
   习惯列表
   ============================================ */
.habit-list {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
  padding: 270rpx 48rpx 200rpx;
  box-sizing: border-box;
}

.list-card {
  background: var(--bg-card);
  border-radius: 16px;
  padding: 16px;
  display: flex;
  align-items: center;
  min-height: 152rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
  border: 1px solid rgba(0,0,0,0.01);
  transition: 0.2s;
  margin-bottom: 14px;
  position: relative;
}

.custom-add-card {
  justify-content: center;
  background: transparent;
  border: 2rpx solid var(--color-border);
  box-shadow: none;
}

.custom-add-card:active {
  transform: scale(0.99);
  background: transparent;
}

.custom-add-plus {
  color: #B7BFC7;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

/* 图标容器：圆角矩形，动态底色，无描边 */
.lc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--theme-bg);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 28rpx;
  border: none;
}

/* 内部 PNG 图片尺寸 */
.icon-img-sm {
  width: 60rpx;
  height: 60rpx;
}

.custom-initial {
  color: var(--c-purple);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

/* 旧样式兼容 */
.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  font-size: 44rpx;
}

.card-icon image {
  width: 48rpx;
  height: 48rpx;
}

/* 主题色背景 - 玉露丹青规范 */
.t-green .lc-icon {
  background-color: var(--bg-green);
}

.t-red .lc-icon {
  background-color: var(--bg-red);
}

.t-yellow .lc-icon {
  background-color: var(--bg-yellow);
}

.t-blue .lc-icon {
  background-color: var(--bg-blue);
}

.t-purple .lc-icon {
  background-color: var(--bg-purple);
}

/* 卡片信息 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.lc-title {
  font-size: 32rpx;
  color: var(--ink-title);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.lc-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 400;
  transform: translateY(-4rpx);
}

/* 添加按钮 */
.add-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  color: var(--text-sub);
  background-color: #F4F6F8;
  transition: all 300ms ease;
  flex-shrink: 0;
}

.add-btn.added {
  background-color: var(--c-primary);
  border-color: var(--c-primary);
}

.btn-icon {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 500;
  width: 100%;
  text-align: center;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn.added .btn-icon {
  color: #fff;
  font-size: 28rpx;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 18rpx;
}

.empty-subtext {
  max-width: 420rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.init-btn {
  width: 360rpx;
  min-height: 92rpx;
  background-color: var(--c-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 36rpx;
  border-radius: 999rpx;
  border: none;
  line-height: 92rpx;
  box-shadow: 0 12rpx 32rpx rgba(56, 163, 133, 0.32);
  transition: transform 150ms ease, box-shadow 150ms ease;
}

.init-btn:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 18rpx rgba(56, 163, 133, 0.22);
}

/* ============================================
   弹窗样式 - 高级阻尼弹窗
   ============================================ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  opacity: 0;
  visibility: hidden;
  transition: all 300ms ease;
  z-index: 9999;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.strategy-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-body);
  border-radius: 24px 24px 0 0;
  padding: 12px 16px calc(20px + var(--safe-bottom));
  box-shadow: 0 -10px 40px rgba(0,0,0,0.05);
  transform: translateY(100%);
  transition: all 300ms ease;
  z-index: 10000;
  max-height: 92vh;
  display: flex;
  flex-direction: column;
}

.strategy-modal.show {
  transform: translateY(0);
}

/* 顶部指示条 */
.modal-indicator {
  width: 60rpx;
  height: 8rpx;
  background-color: rgba(0, 0, 0, 0.12);
  border-radius: 4rpx;
  margin: 0 auto 48rpx;
}

.modal-header {
  margin-bottom: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  min-height: 72rpx;
}

.sh-title {
  font-size: 36rpx;
  color: var(--ink-title);
  letter-spacing: 0.02em;
  font-weight: 600;
}

.custom-title-input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 48rpx;
  background: transparent;
  border: none;
  color: var(--ink-title);
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  box-sizing: border-box;
}

.custom-title-placeholder {
  color: var(--color-disabled-text);
  font-weight: 500;
}

.custom-name-error {
  color: var(--color-danger);
  font-size: 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

/* 设置组 */
.setting-group {
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  padding: 16rpx 0;
}

.setting-group:last-child {
  margin-bottom: 0;
}

/* 设置项 */
.setting-item {
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.setting-item:last-child {
  border-bottom: none;
}

/* 子项样式 */
.setting-item.sub-item {
  padding-left: 96rpx;
  background-color: #fff;
}

.sub-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 选择器显示 */
.picker-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}

.picker-unit {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 线性箭头 */
.item-arrow {
  font-size: 40rpx;
  color: var(--text-sub);
  font-weight: 300;
  margin-left: 8rpx;
  padding: 20rpx;
  margin-right: -20rpx;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 勾选图标 - 未选中时线性圆圈，选中时填充对勾 */
.check-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.15);
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: transparent;
  transition: all 300ms ease;
}

.check-icon.checked {
  border-color: var(--c-primary);
  background-color: var(--c-primary);
  color: #fff;
}

/* 单选图标 */
.radio-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 300ms ease;
}

.radio-icon.checked {
  border-color: var(--c-primary);
  background-color: var(--c-primary);
}

.radio-icon.checked::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  background-color: #fff;
  border-radius: 50%;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.item-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* picker 组件样式重置 */
.item-right picker {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 15px;
  color: var(--color-text-muted);
  text-align: right;
  line-height: 1;
}

.item-value.placeholder {
  font-size: 15px;
  color: var(--color-text-muted);
}

/* 保存按钮 */
.modal-footer {
  padding: 24rpx 0 48rpx;
  width: 100%;
  align-self: stretch;
}

.btn-save {
  width: 100%;
  padding: 28rpx 0;
  background-color: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  border-radius: 999rpx;
  border: none;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
  transition: transform 150ms ease, box-shadow 150ms ease;
}

.btn-save:active {
  transform: scale(0.96);
  box-shadow: 0 4px 12px rgba(56, 163, 133, 0.2);
}

.btn-save.disabled {
  background-color: #C8CDD2;
  color: rgba(255, 255, 255, 0.86);
  box-shadow: none;
}

.btn-save.disabled:active {
  transform: none;
  box-shadow: none;
}

/* ============================================
   删除习惯确认弹窗
   ============================================ */
.delete-habit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.delete-habit-modal.show {
  opacity: 1;
  visibility: visible;
}

.delete-habit-modal-content {
  width: calc(100% - 96rpx);
  min-height: 420rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.delete-habit-modal.show .delete-habit-modal-content {
  transform: scale(1);
}

.delete-habit-modal-header {
  padding: 74rpx 56rpx 30rpx;
  display: flex;
  justify-content: center;
}

.delete-habit-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
  text-align: center;
}

.delete-habit-modal-body {
  padding: 0 68rpx 70rpx;
}

.delete-habit-modal-text {
  display: block;
  width: 100%;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 400;
  color: var(--text-sub);
  text-align: center;
}

.delete-habit-modal-question {
  white-space: nowrap;
}

.delete-habit-modal-hint {
  margin-top: 4rpx;
}

.delete-habit-modal-footer {
  display: flex;
  border-top: 1px solid var(--border-light);
}

.delete-habit-modal-btn {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  background-color: transparent;
}

.delete-habit-modal-btn::after {
  border: none;
}

.delete-habit-modal-cancel {
  color: var(--text-primary);
  border-right: 1px solid var(--border-light);
}

.delete-habit-modal-confirm {
  color: var(--color-danger);
}

/* ============================================
   自定义习惯改名确认弹窗
   ============================================ */
.rename-choice-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100002;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.rename-choice-modal.show {
  opacity: 1;
  visibility: visible;
}

.rename-choice-content {
  width: calc(100% - 32px);
  min-height: 470rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.rename-choice-modal.show .rename-choice-content {
  transform: scale(1);
}

.rename-choice-header {
  padding: 80rpx 56rpx 34rpx;
  display: flex;
  justify-content: center;
}

.rename-choice-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
  text-align: center;
}

.rename-choice-body {
  flex: 1;
  padding: 0 40rpx 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rename-choice-text {
  display: block;
  width: 100%;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 400;
  color: var(--text-sub);
  text-align: center;
  white-space: pre;
}

.rename-choice-actions {
  display: flex;
  flex-shrink: 0;
  border-top: 1px solid var(--border-light);
}

.rename-choice-btn {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 0;
  border: none;
  background-color: transparent;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0;
}

.rename-choice-btn::after {
  border: none;
}

.rename-choice-primary {
  color: var(--c-primary);
}

.rename-choice-secondary {
  color: var(--text-sub);
  border-right: 1px solid var(--border-light);
}

.rename-choice-danger {
  color: var(--color-danger);
}

/* ============================================
   选择器弹窗
   ============================================ */
.picker-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  transform: translateY(100%);
  transition: all 300ms ease;
  z-index: 10001;
  max-height: 85vh;
  box-shadow: var(--shadow-card);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.picker-modal.show {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 简化版头部 - 标题居左，关闭按钮居右 */
.picker-header-simple {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 24rpx;
}

.picker-simple-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.picker-close {
  font-size: 28rpx;
  color: var(--color-text-muted);
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.picker-cancel {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.picker-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.picker-confirm {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

.picker-view {
  height: 400rpx;
  padding: 20rpx 0;
}

/* 选择器列表 */
.picker-list {
  max-height: 600rpx;
  padding: 20rpx 0;
}

.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.picker-option:last-child {
  border-bottom: none;
}

.picker-option.selected .picker-option-text {
  color: var(--c-primary);
}

.picker-option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 400;
}

.picker-check {
  font-size: 36rpx;
  color: var(--primary);
  font-weight: bold;
}

/* 星期列表 */
.weekday-list {
  padding: 20rpx 40rpx;
  max-height: none;
  overflow-y: visible;
}

.weekday-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.weekday-option:last-child {
  border-bottom: none;
}

.weekday-option.checked {
  color: var(--c-primary);
}

.weekday-check {
  font-size: 32rpx;
  color: var(--c-primary);
  font-weight: bold;
}

/* ============================================
   计划开始时间配置样式
   ============================================ */
.plan-start-options {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 8rpx 0;
  width: 100%;
}

.plan-start-option {
  flex: 1;
  min-width: 0;
  padding: 16rpx 0;
  background-color: var(--color-disabled-bg);
  border-radius: 12rpx;
  font-size: 15px;
  color: var(--text-tertiary);
  transition: all 200ms ease;
  border: 2rpx solid transparent;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-start-option.selected {
  background-color: var(--c-primary);
  color: #fff;
}

.plan-start-option.date-picker-option {
  padding: 0;
  background-color: transparent;
  flex: 1;
  min-width: 0;
}

.plan-start-option.date-picker-option picker {
  display: block;
  width: 100%;
  padding: 16rpx 0;
  background-color: var(--color-disabled-bg);
  border-radius: 12rpx;
  font-size: 15px;
  color: var(--text-tertiary);
  text-align: center;
}

.plan-start-option.date-picker-option.selected picker {
  background-color: var(--c-primary);
  color: #fff;
}

/* 提示信息 */
.hint-item {
  padding-top: 8rpx;
  padding-bottom: 24rpx;
}

.plan-start-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  padding-left: 64rpx;
  font-weight: 300;
}

/* ============================================
   日期选择弹窗样式 - 复用间隔天数弹窗样式
   ============================================ */
.picker-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: all 300ms ease;
  z-index: 10000;
}

.picker-modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.date-picker-container {
  padding: 0;
  background-color: #fff;
  position: relative;
  overflow: hidden;
}

.date-picker-container::before,
.date-picker-container::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 80rpx;
  pointer-events: none;
  z-index: 10;
}

.date-picker-container::before {
  top: 0;
  background: linear-gradient(to bottom, #fff 0%, rgba(255,255,255,0.98) 60%, transparent 100%);
}

.date-picker-container::after {
  bottom: 0;
  background: linear-gradient(to top, #fff 0%, rgba(255,255,255,0.98) 60%, transparent 100%);
}

.date-picker-view {
  height: 480rpx;
  width: 100%;
  mask-image: linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%);
}

.date-picker-item {
  line-height: 120rpx;
  height: 120rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-picker-item.selected {
  font-size: 36rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.picker-footer {
  padding: 24rpx 40rpx 48rpx;
  background-color: #fff;
}

.btn-confirm {
  width: 100%;
  padding: 28rpx 0;
  background-color: var(--c-primary);
  color: #fff;
  font-size: 32rpx;
  border-radius: 999rpx;
  border: none;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(56, 163, 133, 0.4);
}

/* ================= 自定义操作菜单弹窗 ================= */
.action-sheet-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.action-sheet-modal.show {
  visibility: visible;
  opacity: 1;
}

.action-sheet-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.action-sheet-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  overflow: hidden;
}

.action-sheet-modal.show .action-sheet-content {
  transform: translateY(0);
}

.action-sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.action-sheet-list {
  padding: 10rpx 0;
}

.action-sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  background-color: #fff;
}

.action-sheet-item:last-child {
  border-bottom: none;
}

.action-sheet-item-text {
  font-size: 32rpx;
  color: var(--c-primary); /* 品牌主题色 - 翠微绿 */
  font-weight: 400;
}

.action-sheet-cancel {
  text-align: center;
  font-size: 32rpx;
  color: var(--color-text-main);
  font-weight: 500;
  padding: 32rpx 40rpx;
  margin-top: 16rpx;
  border-top: 16rpx solid #f5f5f5;
  background-color: #fff;
}
