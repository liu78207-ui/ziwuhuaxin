/* pages/privacy/privacy.wxss */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg-primary);
}

.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  background-color: var(--bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--border-light);
  z-index: 100;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.nav-back {
  position: absolute;
  left: 24rpx;
  top: env(safe-area-inset-top);
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.nav-back-icon {
  font-size: 48rpx;
  color: var(--color-text-main);
  font-weight: bold;
}

.content-scroll {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: env(safe-area-inset-top);
}

.policy-content {
  padding: var(--page-padding) var(--page-padding) calc(var(--page-padding) + env(safe-area-inset-bottom));
}

.policy-block {
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.65;
  margin-bottom: 24rpx;
}

.policy-title {
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-bottom: 28rpx;
}

.policy-meta {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.policy-h2 {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  margin: 48rpx 0 24rpx;
}

.policy-h3 {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  margin: 32rpx 0 18rpx;
}

.policy-list {
  padding-left: 8rpx;
  margin-bottom: 14rpx;
}
