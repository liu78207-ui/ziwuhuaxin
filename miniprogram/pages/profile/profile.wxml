<!--pages/profile/profile.wxml-->
<!-- 归藏页面 - 个人中心 -->

<view class="page-wrapper">
  <!-- 导航栏标题 -->
  <view class="nav-header">
    <text class="nav-title">归藏</text>
  </view>

  <!-- 用户信息区域 -->
  <view class="profile-content">
    <!-- 头像选择按钮 -->
    <view class="avatar-wrapper">
      <button wx:if="{{isLoggedIn}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{isAvatarSaving}}">
        <image class="avatar-img" src="{{displayAvatarUrl || userInfo.avatarUrl || '/assets/icons/profile.png'}}" mode="aspectFill" lazy-load></image>
      </button>
      <button wx:else class="avatar-btn" bindtap="onLogin" disabled="{{isLoggingIn}}">
        <image class="avatar-img" src="{{displayAvatarUrl || userInfo.avatarUrl || '/assets/icons/profile.png'}}" mode="aspectFill" lazy-load></image>
      </button>
    </view>

    <!-- 昵称输入框 -->
    <input
      wx:if="{{isLoggedIn}}"
      type="nickname"
      class="pv-name"
      value="{{userInfo.nickName}}"
      bindblur="onInputNickname"
      placeholder="点击设置昵称"
    />
    <view wx:else class="pv-name pv-login-name" bindtap="onLogin">{{userInfo.nickName}}</view>
    
    <view class="pv-tag">早鸟作息</view>

    <!-- 菜单列表 -->
    <view class="pv-list">
      <view class="pv-list-row" bindtap="viewHistory">
        <text>我的勋章</text>
        <text class="pv-list-arrow">›</text>
      </view>
      <view class="pv-list-row" bindtap="viewSettings">
        <text>偏好设置</text>
        <text class="pv-list-arrow">›</text>
      </view>
    </view>

    <view class="pv-list">
      <view class="pv-list-row" bindtap="viewAbout">
        <text>关于我们</text>
        <text class="pv-list-arrow">›</text>
      </view>
    </view>
  </view>
</view>
