<view class="container">
  <navigation-bar title="归藏"></navigation-bar>

  <view class="profile-header">
    <view class="avatar-section">
      <image class="avatar" src="{{userInfo.avatar || '/miniprogram/assets/icons/profile.png'}}" mode="aspectFill" bindtap="handleLogin"></image>
      <text class="nickname">{{userInfo.nickname || '点击登录'}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="viewBadges">
      <text class="menu-label">我的勋章</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="viewHistory">
      <text class="menu-label">打卡记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="clearData">
      <text class="menu-label">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-info">
    <text>子午花信 v1.0.0</text>
  </view>
</view>
