/* pages/profile/profile.wxss */
/* 归藏页面 - 个人中心 - 玉露丹青极致清透版 */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg-primary);
  padding: 0 48rpx 200rpx;
}

/* ============================================
   导航栏标题
   ============================================ */
.nav-header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.1em;
}

.env-badge {
  position: absolute;
  right: 48rpx;
  top: calc(var(--nav-mask-height) - 58rpx);
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(196, 120, 106, 0.14);
  border: 1rpx solid rgba(196, 120, 106, 0.34);
  color: #9A5E54;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 40rpx;
  box-sizing: border-box;
  pointer-events: none;
  white-space: nowrap;
}

/* ============================================
   用户信息区域
   ============================================ */
.profile-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

/* 头像外层容器 - 控制正圆和阴影 */
.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像按钮 */
.avatar-btn {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 去除 button 默认样式 */
.avatar-btn::after {
  border: none;
  content: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.5);
}

.avatar-icon {
  font-size: 64rpx;
  color: var(--color-disabled-text);
}

/* 昵称 */
.pv-name {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0;
  text-align: center;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 16rpx;
  font-weight: 400;
}

.pv-login-name:active {
  opacity: 0.7;
}

.pv-name-placeholder {
  color: var(--color-text-muted);
}

/* 身份标签 */
.pv-tag {
  font-size: 24rpx;
  color: var(--c-primary);
  border: 1px solid var(--c-primary);
  border-radius: 999rpx;
  letter-spacing: 0;
  padding: 8rpx 24rpx;
  margin-bottom: 80rpx;
  font-weight: 600;
}

/* ============================================
   菜单列表
   ============================================ */
.pv-list {
  width: 100%;
  background-color: var(--bg-card);
  border-radius: 20px;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.pv-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  font-size: 30rpx;
  color: var(--ink-title);
  border-bottom: 1px solid var(--border-light);
  font-weight: 500;
}

.pv-list-row:last-child {
  border-bottom: none;
}

.pv-list-row:active {
  opacity: 0.7;
}

.pv-list-row.is-disabled {
  opacity: 0.45;
}

.pv-list-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.pv-list-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pv-list-value {
  font-size: 15px;
  line-height: 1;
  color: var(--color-text-muted);
  font-weight: 400;
  text-align: right;
}

.pv-list-arrow {
  font-size: 16px;
  color: var(--text-sub);
  font-weight: 300;
  font-family: sans-serif;
}

/* ============================================
   联系我们弹窗
   ============================================ */
.contact-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.contact-modal.show {
  opacity: 1;
  visibility: visible;
}

.contact-modal-content {
  width: calc(100% - 96rpx);
  background-color: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.contact-modal.show .contact-modal-content {
  transform: scale(1);
}

.contact-modal-header {
  padding: 47rpx 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
}

.contact-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-left: 16rpx;
}

.contact-close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}

.contact-close-icon {
  font-size: 36rpx;
  color: var(--text-sub);
  line-height: 1;
}

.contact-modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 56rpx 72rpx;
}

.contact-qrcode {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 48rpx;
  border-radius: var(--radius-card);
}

.contact-tip {
  font-size: 30rpx;
  color: var(--text-secondary);
  text-align: center;
}

.clear-cache-modal-content {
  min-height: 420rpx;
}

.clear-cache-modal-header {
  padding: 74rpx 56rpx 30rpx;
  display: flex;
  justify-content: center;
}

.clear-cache-modal-title {
  margin-left: 0;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.clear-cache-modal-body {
  padding: 0 68rpx 70rpx;
}

.clear-cache-modal-text {
  display: block;
  width: 100%;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 400;
  color: var(--text-sub);
  text-align: center;
}

.clear-cache-modal-footer {
  display: flex;
  border-top: 1px solid var(--border-light);
}

.clear-cache-modal-btn {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  background-color: transparent;
}

.clear-cache-modal-btn::after {
  border: none;
}

.clear-cache-modal-cancel {
  color: var(--text-primary);
  border-right: 1px solid var(--border-light);
}

.clear-cache-modal-confirm {
  color: var(--color-danger);
}
