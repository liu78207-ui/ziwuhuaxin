/* pages/profile/profile.wxss */
/* 归藏页面 - 个人中心 - 玉露丹青极致清透版 */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg-primary);
  padding: 0 48rpx 200rpx;
}

/* ============================================
   导航栏标题
   ============================================ */
.nav-header {
  padding-top: 128rpx;
  padding-bottom: 32rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.1em;
}

/* ============================================
   用户信息区域
   ============================================ */
.profile-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

/* 头像外层容器 - 控制正圆和阴影 */
.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像按钮 */
.avatar-btn {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 去除 button 默认样式 */
.avatar-btn::after {
  border: none;
  content: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  object-fit: cover;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.5);
}

.avatar-icon {
  font-size: 64rpx;
  color: #C5C2BB;
}

/* 昵称 */
.pv-name {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0;
  text-align: center;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 16rpx;
  font-weight: 400;
}

.pv-login-name:active {
  opacity: 0.7;
}

/* 身份标签 */
.pv-tag {
  font-size: 24rpx;
  color: var(--c-primary);
  border: 1px solid var(--c-primary);
  border-radius: 999rpx;
  letter-spacing: 0;
  padding: 8rpx 24rpx;
  margin-bottom: 80rpx;
  font-weight: 600;
}

/* ============================================
   菜单列表
   ============================================ */
.pv-list {
  width: 100%;
  background-color: var(--bg-card);
  border-radius: 20px;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.pv-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  font-size: 30rpx;
  color: var(--ink-title);
  border-bottom: 1px solid var(--border-light);
  font-weight: 500;
}

.pv-list-row:last-child {
  border-bottom: none;
}

.pv-list-row:active {
  opacity: 0.7;
}

.pv-list-arrow {
  font-size: 16px;
  color: var(--text-sub);
  font-weight: 300;
  font-family: sans-serif;
}
