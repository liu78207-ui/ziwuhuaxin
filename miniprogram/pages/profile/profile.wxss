.container {
  min-height: 100vh;
  background-color: #F5F0EB;
}

.profile-header {
  background: linear-gradient(135deg, #E8DFD5 0%, #D4C4B5 100%);
  padding: 120rpx 40rpx 60rpx;
  display: flex;
  justify-content: center;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 4rpx solid #FFFFFF;
}

.nickname {
  font-size: 32rpx;
  color: #2C2C2C;
  margin-top: 20rpx;
  font-weight: 500;
}

.menu-list {
  background-color: #FFFFFF;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 28rpx;
  color: #2C2C2C;
}

.menu-arrow {
  font-size: 32rpx;
  color: #B8B3AA;
}

.version-info {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #B8B3AA;
}
