<!--pages/home/home.wxml-->
<!-- 案台首页 - 子午花信 -->

<view class="page-wrapper">
  <!-- 固定导航栏 -->
  <view class="nav-header-fixed" style="background-color: rgba(244, 246, 248, {{navBgOpacity}});">
    <view class="nav-title-wrap" style="{{navTitleStyle}}">
      <text class="nav-title">子午花信</text>
    </view>
    <view class="env-badge" wx:if="{{showEnvBadge}}">
      <text>{{envBadgeText}}</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content-scroll" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}" bindscroll="onHomeScroll">
    <!-- 琉璃卡片头部 -->
    <view class="hero-card">
      <view class="hc-bg-glow"></view>

      <view class="hc-content">
        <!-- 顶部：时辰 + 经络标签 -->
        <view class="hc-header">
          <text class="time-title text-heavy">{{timeInfo.shichen}}</text>
          <view class="time-meridian-tag">{{timeInfo.meridian}}</view>
        </view>
        
        <!-- 养生建议 -->
        <view class="hero-desc">{{timeInfo.advice}}</view>
        
        <!-- 进度条 -->
        <view class="progress-section">
          <text class="progress-text">今日进度 {{checkedCount}}/{{totalCount}}</text>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
          </view>
        </view>
      </view>
    </view>

  <!-- 今日修习标题 -->
  <view class="sec-title">今日修习</view>

  <!-- 九宫格布局 -->
  <view class="nine-grid" wx:if="{{taskList.length > 0}}">
    <view 
      class="grid-item {{item.themeClass}} {{item._id === pressingId ? 'pressing' : ''}}" 
      wx:for="{{taskList}}" 
      wx:key="_id"
      bindtap="handleCheckin"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
      data-habit-id="{{item._id}}"
      hover-class="grid-item-hover"
      hover-stay-time="200"
    >
      <!-- 图标底板 -->
      <view class="icon-circle {{item.isChecked ? 'checked' : ''}}">
        <image class="icon-img" src="{{item.iconUrl}}" mode="aspectFit" wx:if="{{item.iconUrl}}"/>
        <text class="habit-emoji" wx:else>{{item.emoji || '🧘'}}</text>
        <!-- 印章角标 - 压在圆形背景上 -->
        <view class="stamp-done" wx:if="{{item.isChecked}}">
          <text class="stamp-icon">✓</text>
        </view>
      </view>

      <!-- 习惯信息 -->
      <text class="gi-name">{{item.title || item.name}}</text>
      <text class="gi-sub">{{item.isChecked ? '已坚持 ' + item.streak + ' 天' : (item.meta || '待完成')}}</text>
    </view>
  </view>

  <!-- 空状态 - 添加习惯占位 -->
  <view class="nine-grid" wx:if="{{taskList.length === 0}}">
    <view class="grid-item" bindtap="goToHabits">
      <!-- 图标底板 -->
      <view class="icon-circle empty-icon-base">
        <text class="plus-icon">+</text>
      </view>
    </view>
  </view>
  </scroll-view>
</view>
