/* pages/home/home.wxss */
/* 案台首页 - 子午花信 */

page {
  height: 100%;
  background-color: var(--bg-primary);
}

.page-wrapper {
  height: 100vh;
  background-color: var(--bg-primary);
  position: relative;
  overflow: hidden;
}

/* ============================================
   固定导航栏
   ============================================ */
.nav-header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--nav-mask-height);
  box-sizing: border-box;
  z-index: 100;
  transition: background-color 0.1s ease;
}

.nav-title-wrap {
  margin-left: 48rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ============================================
   可滚动内容区域
   ============================================ */
.content-scroll {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 200rpx 48rpx 200rpx;
  box-sizing: border-box;
}

/* ============================================
   头部区域 - 左右布局
   ============================================ */
.hero-section {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 60rpx 0 40rpx;
  margin-bottom: 0;
}

/* ============================================
   琉璃卡片头部 - 绿色主题
   ============================================ */
.hero-card {
  background: linear-gradient(135deg, #4A9B7F 0%, #3A8B6F 100%);
  border-radius: 24px;
  padding: 28px 24px;
  box-shadow: 0 8px 24px rgba(56, 163, 133, 0.25);
  margin-bottom: 24px;
  position: relative;
  overflow: hidden;
}

/* 卡片内部光晕背景 */
.hc-bg-glow {
  position: absolute;
  right: -40px;
  top: -40px;
  width: 160px;
  height: 160px;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%);
  opacity: 1;
  pointer-events: none;
  z-index: 0;
}

/* 卡片内容区 */
.hc-content {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* 顶部：时辰 + 经络标签 */
.hc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.time-title {
  font-size: 40px;
  color: #FFFFFF !important;
  line-height: 1;
  letter-spacing: -1px;
  font-weight: 800;
}

.time-meridian-tag {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 6px 14px;
  border-radius: 999rpx;
  font-weight: 600;
  align-self: flex-end;
  margin-bottom: 4px;
}

.hero-desc {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 进度条区域 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 12px;
}

.progress-text {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 700;
  white-space: nowrap;
}

.progress-bar {
  flex: 1;
  height: 8px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 4px;
  transition: width 520ms cubic-bezier(0.22, 1.18, 0.34, 1);
}

/* 旧版样式兼容 - 可删除 */
.hero-content {
  flex: 1;
  max-width: 65%;
  position: relative;
  z-index: 1;
}

.hero-image-wrapper {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -10rpx;
  margin-top: -20rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.abstract-decor {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.12;
  pointer-events: none;
}

.decor-1 {
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, #C4786A 0%, transparent 70%);
  top: 0;
  right: 40rpx;
}

.decor-2 {
  width: 140rpx;
  height: 140rpx;
  background: radial-gradient(circle, #8B9A7C 0%, transparent 70%);
  top: 60rpx;
  right: -10rpx;
}

.decor-3 {
  width: 100rpx;
  height: 100rpx;
  background: radial-gradient(circle, #D4A574 0%, transparent 70%);
  top: 10rpx;
  right: 160rpx;
}





.sec-title {
  font-size: 34rpx;
  color: var(--ink-title);
  letter-spacing: 0;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  font-weight: 700;
}

/* 分隔线 */
.section-divider {
  width: 100%;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.05);
  margin: 10rpx 0 40rpx;
}

/* ============================================
   九宫格布局
   ============================================ */
.nine-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 12rpx;
  position: relative;
}

/* 印章角标 */
.stamp-done {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--c-primary, #5E9E84);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(56, 163, 133, 0.35);
}

.stamp-icon {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* 打卡遮罩 */
.check-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.04);
  border-radius: 48rpx;
  z-index: 1;
}

/* 图标底板 - V19 琉璃高饱和混血版 */
.icon-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 52rpx;
  background-color: #FFFFFF;
  border: 4rpx solid #FFFFFF;
  box-shadow: var(--shadow-card);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 16rpx;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 内部 PNG 图片尺寸 */
.icon-img {
  width: 88rpx;
  height: 88rpx;
}

.habit-emoji {
  font-size: 72rpx;
}

/* 习惯名称 */
.gi-name {
  font-size: 29rpx;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  font-weight: 600;
}

/* 习惯元信息 */
.gi-sub {
  font-size: 23rpx;
  color: var(--color-text-muted);
  margin-top: -4rpx;
  font-weight: 400;
}

/* ============================================
   主题色类 - 玉露丹青图标规范
   ============================================ */
/* 绿色主题 - 运动类 (远山青) */
.grid-item.t-green .icon-circle {
  background-color: #FFFFFF !important;
  border-color: #FFFFFF;
}

/* 红色主题 - 理疗类 (珊瑚朱) */
.grid-item.t-red .icon-circle {
  background-color: #FFFFFF !important;
  border-color: #FFFFFF;
}

/* 黄色主题 - 起居类 (秋香黄) */
.grid-item.t-yellow .icon-circle {
  background-color: #FFFFFF !important;
  border-color: #FFFFFF;
}

/* 蓝色主题 - 其他类 (花青黛) */
.grid-item.t-blue .icon-circle {
  background-color: #FFFFFF !important;
  border-color: #FFFFFF;
}

/* 紫色主题 - 特殊类 (紫丁香) */
.grid-item.t-purple .icon-circle {
  background-color: #FFFFFF !important;
  border-color: #FFFFFF;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.add-habit-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dashed-circle {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed var(--border-light);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 56rpx;
  color: var(--color-disabled-text);
  line-height: 1;
  margin-top: -16rpx;
}

/* 空状态图标样式 */
.empty-icon-base {
  background-color: rgba(0, 0, 0, 0.02);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

/* ============================================
   点击动画 - 必须放在最后确保优先级
   ============================================ */
.grid-item {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

/* 图标点击微交互 - 使用 hover-class 实现 */
.grid-item-hover .icon-circle,
.grid-item.pressing .icon-circle {
  transform: translate3d(0, 2rpx, 0) scale(0.94) !important;
  box-shadow: 0 7rpx 22rpx rgba(56, 163, 133, 0.22) !important;
  transition: transform 180ms cubic-bezier(0.22, 1.18, 0.34, 1), box-shadow 160ms ease;
}

/* 图标文字点击反馈 */
