/* pages/stats/stats.wxss */
/* 观心页面 - 玉露丹青极致清透版 */

.page-wrapper {
  min-height: 100vh;
  background-color: var(--bg-primary);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ============================================
   固定头部区域 - 复用修习页面样式
   ============================================ */
.header-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-primary);
  z-index: 100;
  padding: 0 48rpx;
  min-height: var(--nav-mask-height);
}

/* ============================================
   导航栏标题
   ============================================ */
.nav-header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.1em;
}

.env-badge {
  position: absolute;
  right: 48rpx;
  top: calc(var(--nav-mask-height) - 58rpx);
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(196, 120, 106, 0.14);
  border: 1rpx solid rgba(196, 120, 106, 0.34);
  color: #9A5E54;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 40rpx;
  box-sizing: border-box;
  pointer-events: none;
  white-space: nowrap;
}

/* ============================================
   顶部 Tab 切换器
   ============================================ */
.tabs-top {
  display: flex;
  gap: 48rpx;
  margin-bottom: 0;
  padding-bottom: 12rpx;
}

.seg-item {
  font-size: 30rpx;
  color: var(--text-tertiary);
  padding: 12rpx 0;
  position: relative;
  transition: color 300ms ease;
  font-weight: 500;
}

.seg-item.active {
  color: var(--text-primary);
  font-weight: 600;
}

/* Active 状态下方的短划线 - 绿色胶囊形 */
.seg-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background-color: var(--c-primary);
  border-radius: 999rpx;
}

/* ============================================
   可滚动内容区域
   ============================================ */
.content-scroll {
  position: fixed;
  top: 0;
  left: 0;
  right: -48rpx;
  bottom: 0;
  overflow-y: auto;
  overflow-x: hidden;
  width: calc(100vw + 48rpx);
  padding: 270rpx 48rpx 200rpx 0;
  box-sizing: border-box;
}

.content-scroll,
.content-inner,
.month-grid,
.year-list {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.content-scroll::-webkit-scrollbar,
.content-inner::-webkit-scrollbar,
.month-grid::-webkit-scrollbar,
.year-list::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  color: transparent;
  background: transparent !important;
}

.content-inner {
  width: 100vw;
  min-width: 0;
  padding: 0 48rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ============================================
   日期切换控件
   ============================================ */
.date-control {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  padding: 24rpx 40rpx;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-card);
}

.dc-arrow {
  font-size: 48rpx;
  color: var(--text-sub);
  font-weight: 300;
  font-family: sans-serif;
  line-height: 1;
  padding: 20rpx 40rpx;
  margin: -20rpx -40rpx;
}

.date-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  flex: 1;
  padding: 0 24rpx;
}

.dc-title {
  font-size: 28rpx;
  color: var(--ink-title);
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.dc-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.35;
  text-align: center;
}

/* ============================================
   视图容器
   ============================================ */
.stat-view {
  display: none;
}

.stat-view.active {
  display: block;
}

/* ============================================
   视图1：周报表
   ============================================ */
.card-panel {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 32rpx;
}

.cp-title {
  font-size: 30rpx;
  color: var(--ink-main);
  margin-bottom: 24rpx;
  font-weight: 600;
}

.week-tracker {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.wt-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.wt-icon .iconfont {
  font-size: 40rpx;
}

.wt-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--ink-title);
  width: 200rpx;
  flex-shrink: 0;
}

.wt-name {
  font-weight: 600;
}

/* 直接控制图片大小，不带任何底色 */
.stat-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  z-index: 1;
}

.wt-days {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.wt-dot {
  width: 46rpx;
  height: 46rpx;
  border-radius: 16rpx;
  background: #F4F6F8;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 已打卡 - 使用主题颜色 */
.wt-dot.checked {
  background: var(--theme-color, var(--c-primary));
  border: 2rpx solid var(--theme-color, var(--c-primary));
}

/* 未打卡（打卡日）- 白色 + 主题色描边 */
.wt-dot.unchecked {
  background: #FFFFFF;
  border: 2rpx solid var(--theme-color, var(--c-primary));
}

/* 非打卡日 - 浅灰色块 */
.wt-dot.inactive {
  background: #F4F6F8;
  border: 2rpx solid transparent;
}

/* 已删除日期之后 - 浅灰色 */
.wt-dot.deleted {
  background: #F4F6F8;
  border: 2rpx solid transparent;
}

.wt-dot.deleted.checked {
  background: var(--theme-color, var(--c-primary));
  border: 2rpx solid var(--theme-color, var(--c-primary));
}

/* 取消的应修日：与 unchecked 同义，符合"应修未完成"约定 */
.wt-dot.canceled {
  background: #FFFFFF;
  border: 2rpx solid var(--theme-color, var(--c-primary));
}

/* 非应修日：与 inactive 视觉一致 */
.wt-dot.not_required {
  background: #F4F6F8;
  border: 2rpx solid transparent;
}

.wt-dot.low_confidence {
  background: #F4F6F8;
  border: 2rpx solid transparent;
}

/* 未来日期：与非应修日统一为浅灰色块 */
.wt-dot.future {
  background: #F4F6F8;
  border: 2rpx solid transparent;
}

/* 多个 userHabitId 同日部分完成：主题浅底 + 主题色虚线 */
.wt-dot.partial {
  background: var(--theme-bg, var(--c-primary-light));
  border: 2rpx dashed var(--theme-color, var(--c-primary));
}

/* ============================================
   底部数据看板
   ============================================ */
.stat-board {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28rpx;
  margin-top: 32rpx;
}

.sb-card {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.sb-name {
  font-size: 28rpx;
  color: var(--ink-main);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.sb-val {
  font-size: 60rpx;
  color: var(--ink-title);
  line-height: 1;
  display: flex;
  align-items: baseline;
  font-weight: 700;
}

.sb-val text {
  font-size: 24rpx;
  color: var(--ink-main);
  margin-left: 8rpx;
  font-weight: 500;
}

/* 打卡完成率 - 深灰色 */
.sb-val {
  color: var(--ink-title);
}

/* 累计修习 - 主色翡翠绿 */
.sb-val.primary {
  color: var(--c-primary);
}

/* 坚持时日 - 琥珀色 */
.sb-val.accent {
  color: var(--c-amber);
}

/* 最长连日 - 珊瑚色 */
.sb-val.streak {
  color: var(--c-coral);
}

/* ============================================
   视图2：月报表
   ============================================ */
.month-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 24rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.m-card {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 24rpx 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
  display: flex;
  flex-direction: column;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.mc-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 24rpx;
}

.mc-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
  padding: 8rpx 16rpx;
}

.mc-color-bg {
  position: absolute;
  height: 30%;
  left: 0;
  right: 0;
  bottom: 14rpx;
  border-radius: 999rpx;
  z-index: 0;
  background: var(--theme-bg);
}

.mc-icon {
  font-size: 32rpx;
  position: relative;
  z-index: 1;
}

/* 月报表图标更大 */
.m-card .stat-icon {
  width: 40rpx;
  height: 40rpx;
}

.mc-title {
  position: relative;
  font-size: 30rpx;
  color: var(--ink-title);
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.mc-cal {
  display: grid;
  grid-template-columns: repeat(7, 34rpx);
  row-gap: 8rpx;
  column-gap: 8rpx;
  justify-content: center;
  justify-items: center;
}

.mc-cell {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  font-size: 20rpx;
  font-family: sans-serif;
  background: #F4F6F8;
  color: var(--color-disabled-text);
  font-weight: 500;
}

.mc-cell.unchecked {
  background: #FFFFFF;
  border: 2rpx solid var(--theme-color, var(--c-primary));
  color: var(--ink-title);
  box-sizing: border-box;
}

.mc-cell.inactive,
.mc-cell.deleted,
.mc-cell.future {
  background: #F4F6F8;
  border: 2rpx solid transparent;
  color: var(--color-disabled-text);
  box-sizing: border-box;
}

.mc-cell.canceled {
  background: #FFFFFF;
  border: 2rpx solid var(--theme-color, var(--c-primary));
  color: var(--ink-title);
  box-sizing: border-box;
}

.mc-cell.not_required {
  background: #F4F6F8;
  border: 2rpx solid transparent;
  color: var(--color-disabled-text);
  box-sizing: border-box;
}

.mc-cell.low_confidence {
  background: #F4F6F8;
  border: 2rpx solid transparent;
  color: var(--color-disabled-text);
  box-sizing: border-box;
}

.mc-cell.partial {
  background: var(--theme-bg, var(--c-primary-light));
  border: 2rpx dashed var(--theme-color, var(--c-primary));
  color: var(--ink-title);
  box-sizing: border-box;
}

.mc-cell.checked {
  background: var(--theme-color, var(--c-primary));
  color: #FFF;
  font-weight: 600;
  opacity: 0.9;
}

.mc-cell.done {
  background: var(--theme-color, var(--c-primary));
  color: #FFF;
  font-weight: 600;
  opacity: 0.9;
}

.mc-cell.empty {
  background: transparent;
}

/* 统计信息 */
.mc-stats {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.ms-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ms-icon {
  font-size: 22rpx;
}

.ms-icon.done-icon {
  color: var(--c-primary);
}

.ms-icon.day-icon {
  color: #D4A574;
}

.ms-val {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-family: sans-serif;
  font-weight: 550;
}

/* ============================================
   视图3：年报表
   ============================================ */
.year-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow-x: hidden;
}

.y-card {
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-light);
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.yc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.yc-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 年报表图标更大 */
.y-card .stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--theme-bg);
  padding: 12rpx;
  box-sizing: border-box;
}

.yc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  background: var(--theme-bg);
}

.yc-title {
  font-size: 30rpx;
  color: var(--ink-title);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.yc-total {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: normal;
}

/* 热力图 */
.yc-heatmap {
  display: grid;
  grid-template-columns: repeat(53, 1fr);
  grid-template-rows: repeat(7, 1fr);
  gap: 4rpx;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.yh-dot {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 2rpx;
  background: #F4F6F8;
}

.yh-dot.level-1 {
  background: var(--theme-color, var(--c-primary));
  opacity: 0.3;
}

.yh-dot.level-2 {
  background: var(--theme-color, var(--c-primary));
  opacity: 0.6;
}

.yh-dot.level-3 {
  background: var(--theme-color, var(--c-primary));
  opacity: 0.9;
}

/* ============================================
   主题色定义 - CSS 变量映射（使用全局规范色彩）
   ============================================ */
/* 红色主题 - 珊瑚色 */
.theme-red, .t-red {
  --theme-color: var(--c-coral);
  --theme-bg: var(--c-coral-light);
}

/* 绿色主题 - 翡翠绿 */
.theme-green, .t-green {
  --theme-color: var(--c-primary);
  --theme-bg: var(--c-primary-light);
}

/* 蓝色主题 - 湖水蓝 */
.theme-blue, .t-blue {
  --theme-color: var(--c-lake);
  --theme-bg: var(--c-lake-light);
}

/* 黄色主题 - 琥珀色 */
.theme-yellow, .t-yellow {
  --theme-color: var(--c-amber);
  --theme-bg: var(--c-amber-light);
}

/* 紫色主题 - 紫丁香 */
.theme-purple, .t-purple {
  --theme-color: var(--c-purple);
  --theme-bg: var(--c-purple-light);
}

/* ============================================
   已删除习惯样式
   ============================================ */
.wt-row.is-deleted {
  opacity: 0.5;
}

.wt-row.is-deleted .wt-name {
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.wt-row.is-deleted .wt-dot {
  background: #E8E8E8;
  border-color: #E8E8E8;
}

.wt-row.is-deleted .wt-dot.checked {
  background: var(--theme-color, var(--c-primary));
  border-color: var(--theme-color, var(--c-primary));
}

.m-card.is-deleted {
  opacity: 0.5;
}

.m-card.is-deleted .mc-title {
  color: var(--text-tertiary);
}

.y-card.is-deleted {
  opacity: 0.5;
}

.y-card.is-deleted .yc-title {
  color: var(--text-tertiary);
}
