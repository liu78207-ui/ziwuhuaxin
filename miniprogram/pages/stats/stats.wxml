<view class="container">
  <navigation-bar title="观心"></navigation-bar>

  <view class="week-selector">
    <view class="week-nav" bindtap="prevWeek">
      <text class="nav-arrow">‹</text>
    </view>
    <view class="week-range">{{weekRange}}</view>
    <view class="week-nav" bindtap="nextWeek">
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <view class="matrix-section">
    <view class="matrix-header">
      <view class="matrix-corner"></view>
      <view class="weekday-header">
        <text wx:for="{{weekdays}}" wx:key="index">{{item}}</text>
      </view>
    </view>
    
    <scroll-view class="matrix-body" scroll-x>
      <view class="matrix-rows">
        <view class="matrix-row" wx:for="{{statsData.matrix}}" wx:key="index">
          <view class="habit-name">{{item.habit_name}}</view>
          <view class="day-cells">
            <view 
              class="day-cell {{day.status}}" 
              wx:for="{{item.days}}" 
              wx:for-item="day" 
              wx:key="dayIndex">
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="stats-cards">
    <view class="stat-card">
      <text class="stat-value">{{statsData.checkinRate || 0}}%</text>
      <text class="stat-label">打卡率</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{statsData.totalCount || 0}}</text>
      <text class="stat-label">完成次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{statsData.checkinDays || 0}}</text>
      <text class="stat-label">打卡天数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{statsData.maxStreak || 0}}</text>
      <text class="stat-label">最长连续</text>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
