<!--pages/agreement/agreement.wxml-->
<!-- 用户协议页面 -->

<view class="page-wrapper">
  <!-- 导航栏 -->
  <view class="nav-header">
    <text class="nav-title">用户协议</text>
    <view class="nav-back" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content-scroll" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="policy-content">
      <block wx:for="{{contentBlocks}}" wx:key="index">
        <view class="policy-block policy-{{item.type}}">
          <text selectable="{{true}}">{{item.text}}</text>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
