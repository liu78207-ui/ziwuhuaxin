/* pages/reminder-settings/reminder-settings.wxss */

.page-wrapper {
  height: 100vh;
  background-color: #F6F7F9;
  position: relative;
  overflow: hidden;
}

.nav-header {
  position: relative;
  height: var(--nav-mask-height);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.nav-back {
  position: absolute;
  left: 48rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back-icon {
  font-size: 64rpx;
  line-height: 1;
  color: #050505;
  font-family: sans-serif;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #050505;
  letter-spacing: 0;
}

.settings-scroll {
  height: calc(100vh - var(--nav-mask-height));
  padding: 24rpx var(--page-padding) 180rpx;
  box-sizing: border-box;
}

.switch-card,
.time-card,
.auth-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 48rpx;
  box-shadow: 0 14rpx 44rpx rgba(19, 24, 31, 0.04);
  box-sizing: border-box;
  margin-bottom: 56rpx;
}

.switch-card {
  min-height: 128rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.switch-title {
  font-size: 32rpx;
  line-height: 1.35;
  color: #050505;
  font-weight: 700;
}

.card-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  color: #050505;
  font-weight: 700;
  margin-bottom: 34rpx;
}

.time-card {
  padding: 20rpx 20rpx 12rpx;
  border-radius: 20px;
}

.time-card .card-title {
  margin-left: 12rpx;
  margin-bottom: 8rpx;
}

.time-picker-wrap {
  position: relative;
  width: 100%;
  height: 440rpx;
  overflow: hidden;
}

.time-picker-selection {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 50%;
  height: 76rpx;
  transform: translateY(-50%);
  border-radius: 999rpx;
  background-color: rgba(118, 118, 128, 0.12);
  pointer-events: none;
}

.time-picker {
  position: relative;
  z-index: 1;
  width: 48%;
  min-width: 300rpx;
  max-width: 340rpx;
  height: 440rpx;
  margin: 0 auto;
}

.time-item {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  opacity: 0;
}

.time-item text {
  font-size: 48rpx;
  line-height: 96rpx;
  color: #8E8E93;
  font-weight: 400;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  font-variant-numeric: tabular-nums;
}

.time-item.is-selected text {
  font-size: 50rpx;
  color: #1C1C1E;
  font-weight: 400;
}

.time-item.is-selected {
  opacity: 1;
}

.time-item.is-near {
  opacity: 0.62;
}

.time-item.is-edge {
  opacity: 0.32;
}

.time-item.is-far {
  opacity: 0.12;
}

.time-item.is-hidden {
  opacity: 0;
}

.auth-card {
  padding: 34rpx 40rpx;
  margin-top: -16rpx;
}

.auth-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  color: #050505;
  font-weight: 700;
}

.auth-text,
.auth-path {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #5F6670;
}

.auth-action {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background-color: #FF5A78;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  margin: 28rpx 0 4rpx;
}

.auth-action::after {
  border: none;
}

.enable-reminder-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100001;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.enable-reminder-modal.show {
  opacity: 1;
  visibility: visible;
}

.enable-reminder-modal-content {
  width: calc(100% - 96rpx);
  min-height: 420rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.enable-reminder-modal.show .enable-reminder-modal-content {
  transform: scale(1);
}

.enable-reminder-modal-header {
  padding: 74rpx 56rpx 30rpx;
  display: flex;
  justify-content: center;
}

.enable-reminder-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
  text-align: center;
}

.enable-reminder-modal-body {
  padding: 0 68rpx 70rpx;
}

.enable-reminder-modal-text {
  display: block;
  width: 100%;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 400;
  color: var(--text-sub);
  text-align: center;
}

.enable-reminder-modal-hint {
  margin-top: 4rpx;
}

.enable-reminder-modal-footer {
  display: flex;
  border-top: 1px solid var(--border-light);
}

.enable-reminder-modal-btn {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  background-color: transparent;
}

.enable-reminder-modal-btn::after {
  border: none;
}

.enable-reminder-modal-cancel {
  color: var(--text-primary);
  border-right: 1px solid var(--border-light);
}

.enable-reminder-modal-confirm {
  color: var(--color-primary);
}
