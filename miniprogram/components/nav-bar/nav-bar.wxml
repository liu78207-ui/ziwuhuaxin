<!--components/nav-bar/nav-bar.wxml-->
<!-- 自定义导航栏 - 玉露丹青极致清透版 -->

<!-- 状态栏占位 -->
<view class="sys-bar" style="height: {{statusBarHeight}}px;"></view>

<!-- 导航栏主体 -->
<view class="nav-bar" style="height: {{navBarHeight}}px;">
  <!-- 左侧返回按钮区域 -->
  <view class="nav-left" wx:if="{{showBack}}">
    <view class="back-btn" bindtap="handleBack">
      <view class="back-icon"></view>
    </view>
  </view>
  
  <!-- 中间标题区域 -->
  <view class="nav-center">
    <text class="nav-title">{{title}}</text>
  </view>
  
  <!-- 右侧胶囊避让区 -->
  <view class="nav-right" style="width: {{capsuleWidth}}px;"></view>
</view>

<!-- 导航栏占位（防止内容被遮挡） -->
<view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
