{
  "name": "miniprogram-ts-less-quickstart",
  "version": "1.0.0",
  "description": "养生打卡小程序 - 子午流注养生助手",
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js",
    "test:unit": "node node_modules/jest/bin/jest.js __tests__/unit",
    "test:integration": "node node_modules/jest/bin/jest.js __tests__/integration",
    "test:e2e": "node node_modules/jest/bin/jest.js __tests__/e2e --coverage=false",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node node_modules/jest/bin/jest.js --ci --coverage --reporters=default --reporters=jest-junit",
    "test:utils": "node node_modules/jest/bin/jest.js __tests__/unit/utils",
    "test:pages": "node node_modules/jest/bin/jest.js __tests__/unit/pages --coverage=false",
    "test:cloud": "node node_modules/jest/bin/jest.js __tests__/integration/cloudfunctions --coverage=false",
    "verify:cloudfunctions": "node scripts/verify-v1-cloudfunctions.js",
    "verify:legacy-boundaries": "node scripts/verify-legacy-boundaries.js"
  },
  "keywords": [
    "微信小程序",
    "养生",
    "打卡",
    "子午流注",
    "习惯养成"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-junit": "^16.0.0",
    "miniprogram-api-typings": "^2.8.3-1"
  }
}
